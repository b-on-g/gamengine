$bog_gamestudio_app $mol_view
	selected? null
	source? \
	sub /
		<= Tree $mol_page
			title \Сцена
			body /
				<= Nodes $mol_list
					rows <= node_rows /
		<= Canvas $mol_page
			title \Холст
			body /
				<= Draw $bog_gamengine_draw
					scene <= Scene
					cam <= Cam
		<= Inspect $mol_page
			title \Свойства
			body /
				<= Form $mol_form
					form_fields <= fields /
					foot /
		<= Source $mol_page
			title \Исходник
			body /
				<= Editor $mol_textarea
					value? <=> source?
	Doc $bog_gamestudio_doc
		source? <=> source?
		scene => Scene
	Cam $bog_gamengine_cam_flat
		height 6
	Row* $mol_check
		title <= row_title* \
		checked? <=> row_selected*? false
	Field* $mol_form_field
		name <= field_name* \
		content <= field_content* /
	Vec_num* $mol_number
		precision_view 0.01
		precision_change 0.1
		value? <=> vec_value*? +NaN
	Num* $mol_number
		precision_view 0.01
		precision_change 0.1
		value? <=> num_value*? +NaN
	Flag* $mol_check_box
		checked? <=> flag_value*? false
	Text* $mol_string
		value? <=> text_value*? \
	Frame* $mol_select
		value? <=> text_value*? \
		options <= frame_options /string
