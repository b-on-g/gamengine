$bog_gamengine_studio_case $bog_gamengine_scene
	Tile $bog_gamengine_phys_tile
		map \
			\######
			\#....#
			\#..#.#
			\#....#
			\######
	kids /
		<= Tiles $bog_gamengine_tilemap
			name \Карта
			tile <= Tile
			atlas <= Atlas
			palette *
				# \wall
				. \floor
		<= Hero $bog_gamengine_sprite
			name \Герой
			role \hero
			atlas <= Atlas
			frame \hero
			pos? <=> Hero_pos? Float32Array
		<= Coin $bog_gamengine_sprite
			name \Монета
			role \crumb
			atlas <= Atlas
			frame \coin
			pos? <=> Coin_pos? Float32Array
			tint? <=> Coin_tint? Float32Array
		<= Wall $bog_gamengine_sprite
			name \Стена
			atlas <= Atlas
			frame \wall
			pos? <=> Wall_pos? Float32Array
			scale? <=> Wall_scale? Float32Array
		<= Sprite_1 $bog_gamengine_sprite
			name \Ключ
			role \crumb
			atlas <= Atlas
			frame \coin
			pos? <=> Sprite_1_pos? Float32Array
	Atlas $bog_gamengine_atlas
		uris /
			\bog/gamengine/demo/atlas/hero.png
			\bog/gamengine/demo/atlas/coin.png
			\bog/gamengine/demo/atlas/wall.png
			\bog/gamengine/demo/atlas/floor.png
		size 64
