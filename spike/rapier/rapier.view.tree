$bog_gamengine_spike_rapier $mol_page
	title \Rapier
	tools /
		<= Pause $mol_check_box
			title \Пауза
			checked? <=> paused?
	body /
		<= Draw $bog_gamengine_draw
			scene <= Scene
			cam <= Walker
			stat => stat
	foot /
		<= World_stat $mol_view
			sub / <= world_stat \
		<= Stat $mol_view
			sub / <= stat
	count 1000
	Key $bog_gamengine_key
		bind *
			forward / \W
			back / \S
			left / \A
			right / \D
			turn_left / \Q
			turn_right / \E
	Atlas $bog_gamengine_atlas
		uris /
			\bog/gamengine/demo/atlas/wall.png
			\bog/gamengine/demo/atlas/floor.png
		size 64
	Clock $bog_gamengine_clock
		paused? => paused?
	Scene $bog_gamengine_scene
		clock <= Clock
		kids <= nodes /
		batches /
			<= Box_batch $bog_gamengine_batch
				shader <= Solid $bog_gamengine_shader_solid
				shape <= Box $bog_gamengine_shape_box
				atlas <= Atlas
				nodes <= crates /
			<= Floor_batch $bog_gamengine_batch
				shader <= Solid
				shape <= Plane $bog_gamengine_shape_plane
					tile 40
				atlas <= Atlas
				nodes / <= Floor
	World $bog_gamengine_spike_rapier_world
		boxes <= crates /
		starts <= crate_starts /
		floor_size <= floor_size Float32Array
	Crate* $bog_gamengine_mesh
		shape <= Box
		atlas <= Atlas
		frame \wall
		pos? <=> crate_pos*? Float32Array
		rot? <=> crate_rot*? Float32Array
	Floor $bog_gamengine_mesh
		shape <= Plane
		atlas <= Atlas
		frame \floor
		size <= floor_size Float32Array
	Walker $bog_gamengine_demo_room_walker
		key <= Key
		pos? <=> walker_pos? Float32Array
		rot? <=> walker_rot? Float32Array
