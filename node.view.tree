				atlas <= Atlas
				nodes / <= Pillar
			<= Arm_batch $bog_gamengine_batch
				shader <= Skin $bog_gamengine_shader_skin
				shape <= Arm_shape $bog_gamengine_shape_gltf
					data <= arm_data ArrayBuffer
				atlas <= Atlas
				nodes <= arm_nodes /
	Arm $bog_gamengine_mesh_skin
