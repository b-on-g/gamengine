		bind *
			forward / \W
			back / \S
			left / \A
			right / \D
			turn_left / \Q
			turn_right / \E
	Atlas $bog_gamengine_atlas
		uris /
			\bog/gamengine/demo/atlas/wall.png
			\bog/gamengine/demo/atlas/floor.png
		size 64
	Clock $bog_gamengine_clock
		paused? => paused?
	Phys $bog_gamengine_demo_boxes_phys
	Scene $bog_gamengine_scene
		clock <= Clock
		input <= Input
		kids <= nodes /
