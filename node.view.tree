		solid \#
	Atlas $bog_gamengine_atlas
		uris /
			\bog/gamengine/demo/atlas/hero.png
			\bog/gamengine/demo/atlas/coin.png
			\bog/gamengine/demo/atlas/wall.png
			\bog/gamengine/demo/atlas/floor.png
		size 64
	Clock $bog_gamengine_clock
		paused <= paused false
	Key $bog_gamengine_key
		bind *
			left /
				\A
				\left
			right /
				\D
				\right
			up /
				\W
				\up
			down /
				\S
				\down
	Input $bog_gamengine_input
		key <= Key
	Cam $bog_gamengine_cam_flat
		height 11
		pos <= cam_pos Float32Array
	Scene $bog_gamengine_scene
		clock <= Clock
		input <= Input
		cam <= Cam
		kids <= nodes /
		phys <= Phys $bog_gamengine_phys
			bodies <= bodies /
			tile <= Tile
	Tilemap $bog_gamengine_tilemap
		tile <= Tile
		atlas <= Atlas
		palette <= palette *
	Hero $bog_gamengine_demo_crumb_hero
		input <= Input
		pos? <=> hero_pos? Float32Array
	Hero_sprite $bog_gamengine_sprite
		parent <= Hero
		atlas <= Atlas
		frame \hero
		size <= hero_size Float32Array
	Crumb* $bog_gamengine_sprite
		atlas <= Atlas
		frame \coin
		pos <= crumb_pos* Float32Array
		size <= crumb_size Float32Array
	Rule $bog_gamengine_demo_crumb_rule
		hero <= Hero
		crumbs <= crumbs /
		limit 40

$bog_gamengine_demo_crumb_studio $bog_gamengine_studio
	title \Студия крошек

$bog_gamengine_demo_crumb2_level $bog_gamengine_scene
	phys <= Phys $bog_gamengine_phys
		tile <= Tile
		bodies /
			<= Hero
	Tile $bog_gamengine_phys_tile
		map \
			\######
			\#..#.#
			\#..#.#
			\#.#..#
			\######
	kids /
		<= Tiles $bog_gamengine_tilemap
			name \Карта
			tile <= Tile
			atlas <= Atlas
			palette *
				# \wall
				. \floor
		<= Hero $bog_gamengine_phys_walker
			name \Герой
			pos? <=> Hero_pos? Float32Array
			size? <=> Hero_size? Float32Array
			speed 3
			role \hero
		<= Coin $bog_gamengine_sprite
			name \Монета
			atlas <= Atlas
			frame \coin
			pos? <=> Coin_pos? Float32Array
			role \crumb
		<= Sprite_1 $bog_gamengine_sprite
			name \coin
			atlas <= Atlas
			frame \coin
			pos? <=> Sprite_1_pos? Float32Array
			role \crumb
		<= Sprite_2 $bog_gamengine_sprite
			name \coin
			atlas <= Atlas
			frame \coin
			pos? <=> Sprite_2_pos? Float32Array
			role \crumb
		<= Sprite_3 $bog_gamengine_sprite
			name \coin
			atlas <= Atlas
			frame \coin
			pos? <=> Sprite_3_pos? Float32Array
			role \crumb
		<= Sprite_4 $bog_gamengine_sprite
			name \coin
			atlas <= Atlas
			frame \coin
			pos? <=> Sprite_4_pos? Float32Array
			role \crumb
	Atlas $bog_gamengine_atlas
		uris /
			\bog/gamengine/demo/atlas/hero.png
			\bog/gamengine/demo/atlas/coin.png
			\bog/gamengine/demo/atlas/wall.png
			\bog/gamengine/demo/atlas/floor.png
		size 64

$bog_gamengine_demo_crumb2 $mol_page
	title \Крошки мышью
	key_map *
	tools /
		<= Left_label $mol_labeler
			title \Осталось
			content / <= left_str \
		<= Time_label $mol_labeler
			title \Время
			content / <= time_str \
		<= Pause_switch $mol_check_box
			title \Пауза
			checked? <=> paused? false
	body <= field /
		<= Draw $bog_gamengine_draw
			scene <= Scene
			cam <= Cam
			stat => stat
		<= End $mol_page
			title <= end_title \
			body /
				<= End_hint $mol_view
					sub / <= end_hint \
			foot /
				<= Again $mol_button_major
					title \Ещё раз
					click? <=> restart? null
	foot /
		<= Hero_stat $mol_view
			sub / <= hero_str \
		<= Stat $mol_view
			sub / <= stat
	Clock $bog_gamengine_clock
		paused <= paused false
	Key $bog_gamengine_key
		bind *
			left /
				\A
				\left
			right /
				\D
				\right
			up /
				\W
				\up
			down /
				\S
				\down
	Input $bog_gamengine_input
		key <= Key
	Cam $bog_gamengine_cam_flat
		height 11
		pos <= cam_pos Float32Array
	Scene $bog_gamengine_demo_crumb2_level
		clock <= Clock
		input <= Input
		cam <= Cam
		auto_nodes <= nodes /
	Rule $bog_gamengine_demo_crumb2_rule
		hero <= hero null
		crumbs <= crumbs /
		limit 40

$bog_gamengine_demo $mol_book2_catalog
	param \demo
	placeholders /$mol_view
	plugins /
		<= Control $mol_keyboard_state
			key <= key_map *
	spreads *
		quad <= Quad $mol_page
			title \Квад
			tools /
				<= Cam_switch $mol_switch
					value? <=> cam_kind? \flat
					options *
						flat \Плоская
						deep \Объёмная
				<= Pause $mol_check_box
					title \Пауза
					checked? <=> paused?
			body /
				<= Draw $bog_gamengine_draw
					scene <= Scene
					cam <= cam $bog_gamengine_cam
					stat => stat
			foot /
				<= Stat $mol_view
					sub / <= stat
		flat <= Flat $bog_gamengine_demo_flat
		room <= Room $bog_gamengine_demo_room
		boxes <= Boxes $bog_gamengine_demo_boxes
		jumper <= Jumper $bog_gamengine_demo_jumper
		shooter <= Shooter $bog_gamengine_demo_shooter
		legion <= Legion $bog_gamengine_demo_legion
		studio <= Studio $bog_gamengine_studio
		crumb <= Crumb $bog_gamengine_demo_crumb
		crumb_studio <= Crumb_studio $bog_gamengine_demo_crumb_studio
		crumb2 <= Crumb2 $bog_gamengine_demo_crumb2
	Clock $bog_gamengine_clock
		paused? => paused?
	Scene $bog_gamengine_scene
		clock <= Clock
		kids / <= Spin
		batches /
			<= Batch $bog_gamengine_batch
				nodes / <= Spin
	Spin $bog_gamengine_demo_spin
	Cam_flat $bog_gamengine_cam_flat
	Cam_deep $bog_gamengine_cam_deep
		pos <= cam_deep_pos Float32Array
