		screen <= Screen_api
		tile <= Tile
		pos? <=> walker_pos? Float32Array
		rot? <=> walker_rot? Float32Array
	Sun $bog_gamengine_light
		kind \sun
		rot <= sun_rot Float32Array
		power 1
	Light_warm $bog_gamengine_light
