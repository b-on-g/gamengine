			checked? <=> paused?
	body /
		<= Draw $bog_gamengine_draw
			scene <= Scene
			cam <= Walker
			wireframe? => wireframe?
			stat => stat
			event *
				pointerdown? <=> shoot? null
				contextmenu? <=> dig? null
	foot /
		<= Stat $mol_view
			sub / <= stat
		<= Phys_stat $mol_view
			sub / <= phys_stat \
