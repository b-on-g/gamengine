$mol_float $mol_view
	style *
		^
		minHeight \auto

$giper_baza_rich_edit $mol_view
	pawn? $giper_baza_rich
	attr *
		^
		giper_baza_rich_edit_enabled <= enabled true
	hint \
	auto /
		<= selection_load null
		<= selection_sync null
	plugins /
		<= Hotkey $mol_hotkey2 action *
			alt_S? <=> inline_toggle*strong? null
			alt_E? <=> inline_toggle*em? null
			alt_I? <=> inline_toggle*ins? null
			alt_R? <=> inline_toggle*del? null
			alt_C? <=> inline_toggle*code? null
			-
			alt_T? <=> block_wrap*section? null
			alt_Q? <=> block_wrap*blockquote? null
			alt_U? <=> block_wrap*ul? null
			alt_O? <=> block_wrap*ol? null
			alt_P? <=> block_wrap*pre? null
			-
			tab? <=> block_rewrap? null
			shift_tab? <=> block_unwrap? null
	sub /
		<= Tools $mol_float sub /
			<= Inline_format_menu $mol_pick
				hint @ \Inline Formating
				trigger_content /
					<= Inline_format_menu_icon $mol_icon_marker
				bubble_content /
					<= Strong_button $mol_button_minor
						title @ \Strong
						hint \Alt+S
						enabled? <=> selected? false
						click? <=> inline_toggle*strong?
					<= Em_button $mol_button_minor
						title @ \Emphasis
						hint \Alt+E
						enabled? <=> selected? false
						click? <=> inline_toggle*em?
					<= Ins_button $mol_button_minor
						title @ \Insertion
						hint \Alt+I
						enabled? <=> selected? false
						click? <=> inline_toggle*ins?
					<= Del_button $mol_button_minor
						title @ \Deletion
						hint \Alt+R
						enabled? <=> selected? false
						click? <=> inline_toggle*del?
					<= Code_button $mol_button_minor
						title @ \Code
						hint \Alt+C
						enabled? <=> selected? false
						click? <=> inline_toggle*code?
			<= Section_button $mol_button_minor
				hint @ \Titled Section (Alt+T)
				enabled? <=> selected? false
				click? <=> block_wrap*section?
				sub /
					<= Section_icon $mol_icon_format_size
			<= List_bullet_button $mol_button_minor
				hint @ \Unordered List (Alt+U)
				enabled? <=> selected? false
				click? <=> block_wrap*ul?
				sub /
					<= List_bullet_icon $mol_icon_order_bool_ascending
			<= List_number_button $mol_button_minor
				hint @ \Ordered List (Alt+O)
				enabled? <=> selected? false
				click? <=> block_wrap*ol?
				sub /
					<= List_number_icon $mol_icon_order_numeric_ascending
			<= Quote_button $mol_button_minor
				hint @ \Quotation (Alt+Q)
				enabled? <=> selected? false
				click? <=> block_wrap*blockquote?
				sub /
					<= Quote_icon $mol_icon_comment_quote_outline
			<= Preformat_button $mol_button_minor
				hint @ \Preformatted Code (Alt+P)
				enabled? <=> selected? false
				click? <=> block_wrap*pre?
				sub /
					<= Preformat_icon $mol_icon_xml
			<= Unwrap_button $mol_button_minor
				hint @ \Unwrap Block (Shift+Tab)
				enabled? <=> selected? false
				click? <=> block_unwrap?
				sub /
					<= Decrease_icon $mol_icon_arrow_collapse_left
		<= Content $mol_view
			attr *
				contenteditable <= editable? \true
			event *
				input? <=> save? null
				paste? <=> paste? null
				pointermove? <=> hover? null
			sub <= content /

$giper_baza_flex_field $mol_view
	sub / <= Sub $mol_view
	pawn? $giper_baza_pawn
	land = pawn land
	prop $giper_baza_flex_prop
	Enum $mol_select
		enabled <= enabled true
		value? <=> enum? null
		options <= enum_options /
		option_label* <= enum_label* \
	Atom $giper_baza_vary_edit
		enabled <= enabled true
		value? <=> atom_value? null
		schema <= schema null
		selection? <=> atom_selection? /
	Ref $mol_bar sub <= link_content /
		<= Link_dump $giper_baza_unit_sand_dump
			land <= land
			value <= link_value null
		<= Link_pick $mol_select
			enabled <= enabled true
			value? <=> link? null
			options <= link_options /
			option_label* <= link_label* \
		<= Link_new $mol_select
			Filter null
			trigger_content /
				<= Link_new_icon $mol_icon_plus
			value? <=> link_new? null
			dictionary *
				local @ \💼 Local
				pull @ \📢 All pull
				post @ \✍ All post
				read @ \🔎 All read
				deny @ \🔐 Private
	Str $mol_textarea
		enabled <= enabled true
		value? <=> str? \
		selection? <=> str_selection? /
	Time $mol_date
		enabled <= enabled true
		value_moment? <=> time? $mol_time_moment
	Dict $mol_expander
		title <= dict_title \
		content / <= Dict_form $giper_baza_flex_form
			enabled <= enabled true
			pawn <= dict_pawn $giper_baza_dict
	Text $mol_textarea
		enabled <= enabled true
		value? <=> text? \
		selection? <=> text_selection? /
	Rich $giper_baza_rich_edit
		enabled <= enabled true
		pawn? <=> rich_pawn? $giper_baza_rich
	List $mol_list
		rows /
			<= List_drop $mol_drop
				adopt? <=> list_item_adopt? null
				receive? <=> list_receive? null
				allow /
					\move
					\copy
				Sub <= List_tools $mol_bar sub <= list_tools /
					<= List_pick $mol_select
						enabled <= enabled true
						value? <=> list_pick? null
						options <= link_options
						option_label* <= link_label* \
					<= List_item_add $mol_button_minor
						enabled <= enabled true
						click? <=> list_item_add? null
						title \+
					<= List_item_paste $mol_button_minor
						enabled <= enabled true
						click? <=> list_item_paste? null
						title \Paste item
						sub /
							<= List_item_paste_icon $mol_icon_content_paste
			<= List_items $mol_list
				rows <= list_items /
					<= List_item*0 <= List_item_drop* $mol_drop
						adopt? <=> list_item_adopt? null
						receive? <=> list_item_receive*? null
						allow /
							\move
							\copy
						Sub <= List_item_drag* $mol_drag
							end? <=> list_item_drag_end*? null
							transfer *
								text/plain <= list_item_text* \
								text/html <= list_item_html* \
								text/uri-list <= list_item_uri* \
							Sub <= List_item_dump* $giper_baza_unit_sand_dump
								land <= land
								sand <= list_item_sand* $giper_baza_unit_sand
								enabled <= enabled

$giper_baza_flex_form $mol_list
	pawn $giper_baza_dict
	meta $giper_baza_flex_meta
	rows <= fields /
		<= Field*0 $mol_expander
			title <= field_name* \
			expanded? <=> field_expanded*? true
			content / <= Field_content* $mol_view sub / <= Field_control* $giper_baza_flex_field
				pawn? <=> field_pawn*? $giper_baza_pawn
				prop <= field_prop* $giper_baza_flex_prop
				enabled <= enabled true

$giper_baza_pawn_dump $mol_expander
	pawn $giper_baza_pawn
		can_change => can_change
		land => land
	tag \keys
	label /
		<= Head $mol_paragraph sub / <= title \
	addons /
	Tools $mol_view sub /
		^ addons
		- ^ editors
	editors /
		<= Add_key $mol_textarea
			enabled <= can_change
			hint \+
			value? <=> key_new? \
			submit? <=> add_key? null
		<= Add_value $mol_textarea
			enabled <= can_change
			hint \+
			value? <=> value_new? \
			submit? <=> add_value? null
		<= Value_text $mol_textarea
			enabled <= can_change
			value? <=> text? \
		<= Value_str $mol_textarea
			enabled <= can_change
			value? <=> value_str? \
	content <= pawns /
		<= Inner*0 $mol_view sub /
			<= Pawn_inner* $giper_baza_pawn_dump
				tag <= unit_tag*
				addons <= pawn_addons* /
					<= Unit_tag* $mol_select
						value? <=> unit_tag*? \term
						enabled <= can_change
						dictionary *
							term \💼 term
							solo \🔝 solo
							vals \🎹 vals
							keys \🔑 keys
					<= Unit_time* $mol_view sub / <= unit_time* \
					<= Unit_value* $giper_baza_unit_sand_dump
						land <= land
						sand <= unit_value* null
						enabled <= can_change
				pawn <= pawn_inner* $giper_baza_pawn

