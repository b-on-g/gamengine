$giper_baza_land_page $mol_page
	land $giper_baza_land
	pawn $giper_baza_dict
		link => pawn_link
	head /
		<= Pawn_link $giper_baza_link_chip
			link <= pawn_link
		<= Meta_link $giper_baza_link_chip
			link <= meta_link $giper_baza_link
			sub / \✨
